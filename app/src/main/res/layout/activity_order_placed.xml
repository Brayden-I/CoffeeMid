<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OrderPlaced">

    <ImageView
        android:id="@+id/BeanIcon"
        style="@style/HeaderLogo"

        android:src="@drawable/outline_avocado_bean_24"
        android:contentDescription="@string/app_logo"
        />

    <TextView
        android:id="@+id/menu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        style="@style/AppTitle"

        android:text="@string/thank_you_for_ordering_screen" />

<!--    Image-->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:contentDescription="@string/various_coffee_beans_in_cups"
        android:src="@drawable/coffee_pour"
        />

    <TextView
        android:id="@+id/summary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        style="@style/Header"

        android:text="@string/order_summary_screen" />

<!--    Roast-->
    <TextView
        android:text="@string/roast_ordered"
        style="@style/Header2"/>

    <TableRow>
        <TextView
            android:text="@string/roast_level_ordered"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/roast_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>

<!--    Creamer-->
    <TextView
        android:text="@string/creamer_ordered"
        style="@style/Header2"/>
    <TableRow>
        <TextView
            android:text="@string/dairy_ordered"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/dairyCreamer_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/non_dairy_ordered"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/nondairyCreamer_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/half_amp_half_ordered"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/hahCreamer_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
<!--    // Pumps-->
    <TextView
        android:text="@string/pumps_ordered"
        style="@style/Header2"/>
    <TableRow>
        <TextView
            android:text="@string/vanilla_flavor"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/vanillaPump_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/hazlenut_flavor"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/hazlePump_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/coconut_flavor"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/coconutPump_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/rasberry_flavor"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/rasberryPump_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/mango_flavor"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/mangoPump_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/chocolate_flavor"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/chocoPump_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>

<!--    Toppings-->
    <TextView
        android:text="@string/toppings_ordered"
        style="@style/Header2"/>

    <TableRow>
        <TextView
            android:text="@string/whipped_cream"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/whipTopping_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/cold_foam"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/foamTopping_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>
    <TableRow>
        <TextView
            android:text="@string/caramel_syrup"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/caramelTopping_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>

<!--    Note-->
    <TableRow>
        <TextView
            android:text="@string/additional_note_ordered"
            android:textColor="?attr/colorSecondary"/>
        <TextView
            android:id="@+id/AdditionalNote_textview"
            android:textColor="?attr/colorPrimary"/>
    </TableRow>

<!--    Back button-->
    <Button
        android:id="@+id/BackBtn"
        android:text="@string/back_to_main_screen"/>
</TableLayout>